<odoo>
  <data>
    <record model="ir.ui.view" id="maya_core.employee_tree">
      <field name="name">Lista de empleados</field>
      <field name="model">maya_core.employee</field>
      <field name="arch" type="xml">
        <list>
          <field name="surname" />
          <field name="name"/>
          <field name="phone_extension"/>
          <field name="work_email"/>
          <field name="employee_type"/>
          <field name="team_ids" widget="many2many_tags" />
          <!-- <field name="roles_ids" widget="many2many_tags" /> -->
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="maya_core.employee_form">
      <field name="name">Gestión de empleados</field>
      <field name="model">maya_core.employee</field>
      <field name="arch" type="xml">
        <form>
          <group col="2">
            <group>
              <field name="user_id" />
              <field name="dni"/>
              <field name="surname" />
              <field name="name"/>
            </group>
            <group>
              <field name="phone_extension" />
              <field name="work_email"/>
              <field name="employee_type"/>
              <field name="active"/>
            </group>  
          </group>
          <notebook>
            <page string='Equipos'>
              <group>
                <field name="team_ids">
                  <list>
                    <field name="name"/>
                    <field name="is_departament" widget="boolean_favorite" readonly="1"/>
                  </list>
                </field>
              </group>
            </page>
            <!-- <page string='Módulos'>
              <group>
                <field name="subjects_ids">
                  <tree>
                    <field name="subject_id" string="Módulo"/>
                    <field name="course_id" string="Ciclo"/> 
                  </tree>
                </field>
              </group>
            </page>" -->
            <page string = "Situación administrativa">
              <group>
                <field name="position_type"/>
              </group>
            </page>
            <page string = "Administración interna">
              <group col="2">
                <group>
                  <field name="car_registration_number_1" placeholder="1234ABC"/>
                  <field name="car_registration_number_2" placeholder="1234ABC"/>
                  <field name="car_registration_number_3" placeholder="1234ABC"/>
                </group>
              </group>
            </page>
            <page string = "Sustituciones">
              <group>
                <field name="sick_leave"/>
                <field name="replaced_by_ids"/>
              </group>
            </page>
          </notebook>
        </form>
      </field>
    </record>
   
    <!-- Views de session_Schedule -->
    <record model="ir.ui.view" id="maya_core.session_schedule_list">
      <field name="name">Lista de sesiones</field>
      <field name="model">maya_core.session_schedule</field>
      <field name="arch" type="xml">
        <list editable="bottom" default_order="week_day, start_time" decoration-danger="active == False">
          <field name="location_id" column_invisible="True"/>
          <field name="name"/>
          <field name="week_day"/>
          <field name="start_time" widget="float_time"/>
          <field name="end_time" widget="float_time"/>
          <field name="duration"/>
          <field name="active" widget="boolean_button"/>
          <groupby name="location_id">
          </groupby>
        </list>
      </field>
    </record>

    <record id="maya_core_session_schedule_search" model="ir.ui.view">
        <field name="name">session.schedule.search</field>
        <field name="model">maya_core.session_schedule</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Ubicación" name="groupby_location" context="{'group_by': 'location_id'}"/>
                <searchpanel>
                    <field name="week_day" string="Días de la semana" icon="fa-calendar" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="maya_core.session_schedule_form">
      <field name="name">Formulario de sesiones</field>
      <field name="model">maya_core.session_schedule</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <widget name="web_ribbon" title="Archivada" bg_color="bg-danger" invisible="active == True"/>
            <div class="oe_title">
              <label for="name" string="Descripción de la sesión"/>
              <h1>
                <field name="name" placeholder="Ej. L01"/>
              </h1>
            </div>
            <group>
              <group string="Horario">
                <field name="week_day"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration" widget="float_time"/>
              </group>
              <group string="Datos Generales">
                <field name="location_id"/>
                <field name="active" invisible="1"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    
    <!-- Views de Location -->
    <record id="maya_core.view_location_list" model="ir.ui.view">
      <field name="name">Lista de Ubicaciones</field>
      <field name="model">maya_core.location</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="address"/>
        </list>
      </field>
    </record>

    <record id="maya_core.view_location_form" model="ir.ui.view">
      <field name="name">Gestión de Ubicaciones</field>
      <field name="model">maya_core.location</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <!--tabla y estilos para la alineacion horizontal de la imagen con el titulo (oe_title alinea siempre la imagen a la derecha) -->
            <table style="width: 100%; margin-bottom: 20px;">
              <tr>
                <td style="width: 170px; vertical-align: top;">
                  <field name="image" widget="image" options="{'size': [150, 200], 'zoom': true}"/>
                </td>
                
                <td style="vertical-align: top;">
                  <div class="oe_title">
                      <label for="name" string="Nombre"/>
                      <h1>
                          <field name="name"/>
                      </h1>
                      <!-- tags con many2many_tags -->
                  </div>
                </td>
              </tr>
            </table> 
            <group>
              <group string="Dirección y Teléfono">
                <field name="address"/>
                <field name="map_url" widget="url"/>
              </group>
              <group string="Información">
                <field name="description"/>
                <!-- campo de horario -->
              </group>
            </group>
            <notebook>
              <page string="Plano">
                <field name="floor_plan" widget="image" options="{'size': [0, 600], 'zoom': true}"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Views de Place -->
    <record id="maya_core.view_place_list" model="ir.ui.view">
      <field name="name">mmaya_core.place.list</field>
      <field name="model">maya_core.place</field>
      <field name="arch" type="xml">
        <list string="Espacios de trabajo">
          <field name="name"/>
          <field name="location_id"/>
        </list>
      </field>
    </record>

    <record id="maya_core.view_place_form" model="ir.ui.view">
      <field name="name">Gestión de espacios de trabajo</field>
      <field name="model">maya_core.place</field>
      <field name="arch" type="xml">
        <form string="Espacio">
        
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Nombre del espacio..."/>
            </h1>
          </div>

          <group name="main_info" string="Información Principal">
            <div class="d-flex align-items-start">
              <div style="min-width: 150px; margin-left: 50px;" class="justify-content-center">
                <field name="image" class="oe_avatar m-0" widget="image" style="float: none;" options="{'zoom': true}"/>
              </div>
              <div class="flex-grow-1" style="margin-top: 0; min-width: 700px">
                <group col="2" >
                    <field name="location_id" options="{'no_create': True}" class="w-100"/>
                    <field name="description" placeholder="Descripción detallada del espacio..." class="w-100"/>
                </group>
              </div>
            </div>
          </group>

          <notebook>
            <page string = 'Imágenes'>
              <group>
                <field name="image" widget="image" options="{'size': [150, 200], 'zoom': true}" />
                <field name="image_360" widget="image" options="{'size': [150, 200], 'zoom': true}" />
                <field name="floor_plan_image" widget="image" options="{'size': [150, 200], 'zoom': true}"/>
                <field name="is_panoramic"/>
              </group>
            </page>
          </notebook>

        </form>
      </field>
    </record>

    <!-- Views de Team -->
    <record model="ir.ui.view" id="maya_core.team_tree">
      <field name="name">Lista de equipos</field>
      <field name="model">maya_core.team</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="abbr"/>
          <field name="is_departament" widget="boolean_favorite" readonly="1"/>
        </list>
      </field>
    </record>

    <!-- Herencia de la vista lista de usuarios -->
    <record id="view_users_tree_inherit_employee_info" model="ir.ui.view">
      <field name="name">res.users.tree - Nombre completo</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_tree"/>   <!-- Vista original -->
      <field name="arch" type="xml">  
        <!-- Reemplazamos el campo name por employee_info -->
        <field name="name" position="replace">
            <field name="employee_info"/>
        </field>
      </field>
    </record>

    <!-- Herencia de la vista Formulario de Usuarios -->
    <record id="view_users_form_inherit_employee_info" model="ir.ui.view">
      <field name="name">res.users.form - Nombre y Apellido</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form"/>   <!-- Vista original de Odoo -->
      <field name="arch" type="xml">

        <!-- Reemplazamos el campo 'name' por name + surname uno al lado del otro -->
        <field name="name" position="replace">
          <group col="2">
            <field name="name" string="Nombre" />
            <field name="surname" string="Apellidos" style="font-size: 0.8em"/>
          </group>
        </field>

      </field>
    </record>

    <record model="ir.ui.view" id="maya_core.study_tree">
      <field name="name">Lista de Estudioss</field>
      <field name="model">maya_core.study</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="abbr"/>
          <field name="code"/>
          <field name="company_id"/>
          <field name="subjects_ids"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="maya_core.study_form">
      <field name="name">Gestión de estudios</field>
      <field name="model">maya_core.study</field>
      <field name="arch" type="xml">
        <form>
         <div class="oe_title">
            <h1>
              <field name="name" placeholder="Nombre del estudio..."/>
            </h1>
          </div>
          <group col="3" string="Información">
            <group>
              <field name="abbr" />
              <field name="code" />
            </group>
          
            <group>
              <field name="family" />
              <field name="grade" />   
            </group>
            <group>
              <field name="law" />
            </group>
          </group>
          <group string="Asignaturas / Módulos">
            <field name="subjects_ids">
              <list>
                <field name="name" />
                <field name="abbr" />
                <field name="code" />
              </list> 
            </field>
          </group>  
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="maya_core.action_employee">
      <field name="name">Empleados</field>
      <field name="res_model">maya_core.employee</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_location">
      <field name="name">Ubicaciones</field>
      <field name="res_model">maya_core.location</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_place">
      <field name="name">Espacios</field>
      <field name="res_model">maya_core.place</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_team">
      <field name="name">Departamentos y Equipos</field>
      <field name="res_model">maya_core.team</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_study">
      <field name="name">Estudios</field>
      <field name="res_model">maya_core.study</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_subject">
      <field name="name">Asignaturas</field>
      <field name="res_model">maya_core.subject</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_session_schedule">
      <field name="name">Horarios de sesiones</field>
      <field name="res_model">maya_core.session_schedule</field>
      <field name="view_mode">list,form</field>
      <field name="context">{'search_default_groupby_location': 1}</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Maya | Core" id="maya_core.menu_root" sequence="1"/>

    <!-- menu categories -->
    <menuitem name="Centro" id="maya_core.school" parent="maya_core.menu_root" sequence="1"/>
    <menuitem name="Curso" id="maya_core.course_menu" parent="maya_core.menu_root" sequence="2"/>
     
    <!-- menú centro -->
    <menuitem name="Disposición física" id="maya_core.physical_layout_school" parent="maya_core.school" sequence="1"/>
    <menuitem name="Organización " id="maya_core.organization_school" parent="maya_core.school" sequence="2"/>
    <menuitem name="Enseñanzas " id="maya_core.teaching_school" parent="maya_core.school" sequence="3"/>

    <!-- menú disposición física -->
    <menuitem name="Ubicaciones" id="maya_core.school_location" parent="maya_core.physical_layout_school"
              action="maya_core.action_location" sequence="1"/>
    <menuitem name="Espacios" id="maya_core.school_place" parent="maya_core.physical_layout_school"
              action="maya_core.action_place" sequence="2"/>

    <!-- menú organización -->
    <menuitem name="Equipos" id="maya_core.school_team" parent="maya_core.organization_school"
              action="maya_core.action_team" sequence="3"/>
    <menuitem name="Horario de sesiones" id="maya_core.school_session_schedule" parent="maya_core.organization_school"
              action="maya_core.action_session_schedule" sequence="4"/>

    <!-- menú enseñanza -->
    <menuitem name="Estudios" id="maya_core.school_study" parent="maya_core.teaching_school"
              action="maya_core.action_study" sequence="5"/>
    <menuitem name="Asignaturas" id="maya_core.school_subject" parent="maya_core.teaching_school"
              action="maya_core.action_subject" sequence="6"/>


    <!-- menú Curso -->
    <menuitem name="Empleados" id="maya_core.course_employee" parent="maya_core.course_menu"
              action="maya_core.action_employee" sequence="3"/>

  </data>
</odoo>
