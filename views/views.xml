<odoo>
  <data>
  <record model="ir.ui.view" id="maya_core.employee_tree">
      <field name="name">Lista de empleados</field>
      <field name="model">maya_core.employee</field>
      <field name="arch" type="xml">
        <list>
          <field name="surname" />
          <field name="name"/>
          <field name="phone_extension"/>
          <field name="work_email"/>
          <field name="employee_type"/>
          <!-- <field name="departament_ids" widget="many2many_tags" />
          <field name="roles_ids" widget="many2many_tags" /> -->
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="maya_core.employee_form">
      <field name="name">Gestión de empleados</field>
      <field name="model">maya_core.employee</field>
      <field name="arch" type="xml">
        <form>
          <group col="2">
            <group>
              <field name="user_id" />
              <field name="dni"/>
              <field name="surname" />
              <field name="name"/>
            </group>
            <group>
              <field name="phone_extension" />
              <field name="work_email"/>
              <field name="employee_type"/>
              <field name="active"/>
            </group>  
          </group>
          <notebook>
           <!--  <page string='Departamentos'>
              <group>
                <field name="departament_ids"/>
              </group>
            </page> -->
            <!-- <page string='Módulos'>
              <group>
                <field name="subjects_ids">
                  <tree>
                    <field name="subject_id" string="Módulo"/>
                    <field name="course_id" string="Ciclo"/> 
                  </tree>
                </field>
              </group>
            </page>" -->
            <page string = "Situación administrativa">
              <group>
                <field name="position_type"/>
              </group>
            </page>
            <page string = "Administración interna">
              <group col="2">
                <group>
                  <field name="car_registration_number_1" placeholder="1234ABC"/>
                  <field name="car_registration_number_2" placeholder="1234ABC"/>
                  <field name="car_registration_number_3" placeholder="1234ABC"/>
                </group>
              </group>
            </page>
            <page string = "Sustituciones">
              <group>
                <field name="sick_leave"/>
                <field name="replaced_by_ids"/>
              </group>
            </page>
          </notebook>
        </form>
      </field>
    </record>

    <!-- Views de Location -->
    <record id="maya_core.location_list" model="ir.ui.view">
        <field name="name">Lista de Ubicaciones</field>
        <field name="model">maya_core.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="address"/>
                <field name="phone_number" widget="phone"/>
            </list>
        </field>
    </record>

    <record id="maya_core.location_form" model="ir.ui.view">
        <field name="name">Gestión de Ubicaciones</field>
        <field name="model">maya_core.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!--tabla y estilos para la alineacion horizontal de la imagen con el titulo (oe_title alinea siempre la imagen a la derecha) -->
                    <table style="width: 100%; margin-bottom: 20px;">
                        <tr>
                            <td style="width: 170px; vertical-align: top;">
                                <field name="image" widget="image" options="{'size': [150, 200], 'zoom': true}"/>
                            </td>
                            
                            <td style="vertical-align: top;">
                                <div class="oe_title">
                                    <label for="name" string="Nombre"/>
                                    <h1>
                                        <field name="name"/>
                                    </h1>
                                    <!-- tags con many2many_tags -->
                                </div>
                            </td>
                        </tr>
                    </table> 
                    <group>
                        <group string="Dirección y Teléfono">
                            <field name="phone_number" widget="phone"/>
                            <field name="address"/>
                            <field name="map_url" widget="url"/>
                        </group>
                        <group string="Información">
                            <field name="description"/>
                            <!-- campo de horario -->
                        </group>
                    </group>
                    <notebook>
                      <page string="Plano">
                            <field name="floor_plan" widget="image" options="{'size': [0, 600], 'zoom': true}"/>
                      </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="maya_core.action_employee">
      <field name="name">Empleados</field>
      <field name="res_model">maya_core.employee</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_location">
      <field name="name">Ubicaciones</field>
      <field name="res_model">maya_core.location</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_departament">
      <field name="name">Departamentos</field>
      <field name="res_model">maya_core.departament</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_course">
      <field name="name">Cursos</field>
      <field name="res_model">maya_core.course</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="maya_core.action_session_schedule">
      <field name="name">Horarios de sesiones</field>
      <field name="res_model">maya_core.session_schedule</field>
      <field name="view_mode">list</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Maya | Core" id="maya_core.menu_root" sequence="1"/>

    <!-- menu categories -->
    <menuitem name="Centro" id="maya_core.school" parent="maya_core.menu_root" sequence="1"/>
    <menuitem name="Curso" id="maya_core.course" parent="maya_core.menu_root" sequence="2"/>
     
    <!-- menú centro -->
    <menuitem name="Ubicaciones" id="maya_core.school_location" parent="maya_core.school"
              action="maya_core.action_location" sequence="1"/>
    <menuitem name="Cursos" id="maya_core.school_course" parent="maya_core.school"
              action="maya_core.action_course" sequence="2"/>
    <menuitem name="Departamentos" id="maya_core.school_departament" parent="maya_core.school"
              action="maya_core.action_departament" sequence="3"/>
    <menuitem name="Horario de sesiones" id="maya_core.school_session_schedule" parent="maya_core.school"
              action="maya_core.action_session_schedule" sequence="4"/>

    <!-- menú Curso -->
    <menuitem name="Empleados" id="maya_core.course_employee" parent="maya_core.course"
              action="maya_core.action_employee" sequence="3"/>

  </data>
</odoo>
