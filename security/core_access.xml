    <!-- ************************************************************************* -->
    <!-- Reglas de registro. Condiciones que se deben dar para que algo ocurra. 
         Se ejecutan registro por registro                                         -->
    <!-- ************************************************************************* -->

    <!-- Regla para que un usuario de la Ciclos no vea los estudios de la FPA o Bachiller y viceversa -->
    <record id="maya_core_course_study" model="ir.rule">
      <field name="name">Cursos multi-empresa</field>
      <field name="model_id" ref="model_maya_core_study"/>
      <field name="global" eval="True"/>
      <field name="domain_force">
          ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
      </field>
    </record>



  </data>
</odoo>
