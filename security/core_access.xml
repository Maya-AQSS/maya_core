<odoo>
  <data>
    <!-- ******************************************************** -->
    <!-- permisos sobre modelos                                   -->
    <!-- ******************************************************** -->

    <!-- EMPLOYEE -->
    <record id="maya_core.employee_admin_user_access" model="ir.model.access">
      <field name="name">Acceso Administrador a los empleados</field>
      <field name="model_id" ref="model_maya_core_employee"/>
      <field name="group_id" ref="base.group_user"></field>  <!-- TOCHANGE! permiso temporal -->
      <field name="perm_read">1</field>
      <field name="perm_create">1</field>
      <field name="perm_write">1</field>
      <field name="perm_unlink">1</field>
    </record>

    <!-- DEPARTAMENT -->
    <record id="maya_core.departament_admin_user_access" model="ir.model.access">
      <field name="name">Acceso Administrador a los departamentos</field>
      <field name="model_id" ref="model_maya_core_departament"/>
      <field name="group_id" ref="base.group_user"></field>  <!-- TOCHANGE! permiso temporal -->
      <field name="perm_read">1</field>
      <field name="perm_create">1</field>
      <field name="perm_write">1</field>
      <field name="perm_unlink">1</field>
    </record>

    <!-- COURSE -->
    <record id="maya_core.course_admin_user_access" model="ir.model.access">
      <field name="name">Acceso Administrador a los cursos</field>
      <field name="model_id" ref="model_maya_core_course"/>
      <field name="group_id" ref="base.group_user"></field>  <!-- TOCHANGE! permiso temporal -->
      <field name="perm_read">1</field>
      <field name="perm_create">1</field>
      <field name="perm_write">1</field>
      <field name="perm_unlink">1</field>
    </record>

    <!-- LOCATION -->
    <record id="maya_core.location_admin_user_access" model="ir.model.access">
      <field name="name">Acceso Administrador a las ubicaciones</field>
      <field name="model_id" ref="model_maya_core_location"/>
      <field name="group_id" ref="base.group_user"></field>  <!-- TOCHANGE! permiso temporal -->
      <field name="perm_read">1</field>
      <field name="perm_create">1</field>
      <field name="perm_write">1</field>
      <field name="perm_unlink">1</field>
    </record>

    <!-- SESSION SCHEDULE -->
    <record id="maya_core.session_schedule_admin_user_access" model="ir.model.access">
      <field name="name">Acceso Administrador a los horarios de sesiones</field>
      <field name="model_id" ref="model_maya_core_session_schedule"/>
      <field name="group_id" ref="base.group_user"></field>  <!-- TOCHANGE! permiso temporal -->
      <field name="perm_read">1</field>
      <field name="perm_create">1</field>
      <field name="perm_write">1</field>
      <field name="perm_unlink">1</field>
    </record>

    <!-- ************************************************************************* -->
    <!-- Reglas de registro. Condiciones que se deben dar para que algo ocurra. 
         Se ejecutan registro por registro                                         -->
    <!-- ************************************************************************* -->

    <!-- Regla para que un usuario de la Ciclos no vea los cursos de la FPA o Bachiller y viceversa -->
    <record id="maya_core_course_rule" model="ir.rule">
      <field name="name">Cursos multi-empresa</field>
      <field name="model_id" ref="model_maya_core_course"/>
      <field name="global" eval="True"/>
      <field name="domain_force">
          ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
      </field>
    </record>



  </data>
</odoo>
